# 前端环境变量（构建时注入，会打包进公开的客户端 bundle）
# 复制本文件为 .env 并填入实际值。注意：REACT_APP_* 一律为公开值。

# Supabase 项目地址
REACT_APP_SUPABASE_URL=https://your-project.supabase.co

# Supabase 公开 anon / publishable key（受 Row Level Security 保护，可公开）
REACT_APP_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxx

# 语音识别中继 Worker 的 WebSocket 地址（Cloudflare Worker）
REACT_APP_PARAFORMER_WS_URL=wss://your-asr-relay.workers.dev

# ---------------------------------------------------------------------------
# 以下为服务端密钥，不在前端配置，分别设置在 Cloudflare Pages / Worker 后台：
#   Pages Functions:  DASHSCOPE_API_KEY, SUPABASE_JWT_SECRET, SUPABASE_URL
#   ASR Relay Worker: DASHSCOPE_API_KEY (secret), ALLOWED_ORIGINS (可选)
# ---------------------------------------------------------------------------
